{
  "name": "game-commerce-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "check": "node --check src/server.js && node --check public/app.js && node --check public/scene.js && node --test",
    "funnel": "node --env-file-if-exists=.env scripts/funnel.js",
    "test:browser": "node scripts/browser-smoke.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "MIT",
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
