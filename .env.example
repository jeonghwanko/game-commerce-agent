# Defaults run entirely offline; no payment or AI API is called.
PAYMENT_PROVIDER=mock
AI_PROVIDER=mock
AUTH_MODE=anonymous-demo
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/commerce.sqlite
# Only needed after approval to configure an existing Sandbox app:
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Alternative: entire OAuth Authorization value supplied as an opaque network-secret placeholder.
# Leave both CLIENT_ID and CLIENT_SECRET empty when using this mode.
PAYPAL_OAUTH_BASIC_AUTH_HEADER=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional real AI, separately opt-in; incurs provider usage:
OPENAI_API_KEY=
OPENAI_MODEL=

# Real AI is fail-closed: a host principal adapter, explicit enablement and
# a positive durable total attempt ceiling are ALL required. Calls wait for confirmed configuration.
AI_ACCESS_ENABLED=false
AI_TOTAL_CALL_LIMIT=0
# All webhook requests: durable 60-second window; verification is never skipped.
WEBHOOK_WINDOW_VERIFY_LIMIT=100

# Optional independent sandbox demo host (not private game integration).
# No values are provisioned. Operator supplies existing approved test access separately.
# Run src/sandbox-demo.js explicitly; npm start does not enable this host.
SANDBOX_DEMO_HOST_ENABLED=false
# Operator attests an EXISTING approved HTTPS webhook route/registration is ready.
# This does not provision or verify a route. Payment demo additionally requires
# --start --confirm-sandbox-requests; --check is offline and does not read secrets.
SANDBOX_WEBHOOK_ROUTE_READY=false
DEMO_ACCESS_USER=
DEMO_ACCESS_PASSWORD=

# Evaluation only: set true after explicit confirmation of THIS execution environment.
EVAL_CONFIGURATION_READY=false
