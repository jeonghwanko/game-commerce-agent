# Defaults run entirely offline; no payment or AI API is called.
PAYMENT_PROVIDER=mock
AI_PROVIDER=mock
AUTH_MODE=anonymous-demo
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/commerce.sqlite
# Only needed after approval to configure an existing Sandbox app:
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional real AI, separately opt-in; incurs provider usage:
OPENAI_API_KEY=
OPENAI_MODEL=

# Real AI is fail-closed: a host principal adapter, explicit enablement and
# a positive durable total attempt ceiling are ALL required. No API calls approved yet.
AI_ACCESS_ENABLED=false
AI_TOTAL_CALL_LIMIT=0
# Across all webhook requests, persisted in this database; no automatic reset.
WEBHOOK_TOTAL_VERIFY_LIMIT=100
